{
  "manifest_version": 2,
  "id": "cateye.deepseek-harness-connect",
  "version": "1.0.0",
  "name": "DeepSeek Harness 连接插件",
  "description": "通过统一连接插件（cateye.connect-hub）将 QQ 命令转发到本地 PC：DeepSeek Harness 对话（/deepseek）、截图（/sj）、CMD（/cmd、/sdcmd）、运行程序（/run）、预设脚本（/preset）。",
  "author": {
    "name": "cateye",
    "url": "https://github.com/cateye"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateye/cateye_connect_all-in-one"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "plugin",
      "id": "cateye.connect-hub",
      "version_spec": ">=1.0.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.forward",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
